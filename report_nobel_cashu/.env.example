# Snowflake Connection Configuration (Local Development Only)
# Copy this file to .env and fill in your credentials

SNOWFLAKE_USER=your_username
# Password auth (alternative to private key)
# SNOWFLAKE_PASSWORD=your_password

# Private key auth (recommended)
SNOWFLAKE_PRIVATE_KEY_FILE=C:/path/to/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=your_passphrase

SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_WAREHOUSE=dbt_wh
SNOWFLAKE_DATABASE=cashu_dev
SNOWFLAKE_SCHEMA=RPT_DATA
